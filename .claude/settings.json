{
    "model": "opusplan",
    "autoCompactEnabled": true,
    "autoCompactWindow": 250000,
    "worktree": {
        "baseRef": "head"
    },
    "permissions": {
        "defaultMode": "plan",
        "deny": [
            "Read(./.env)",
            "Read(./.env.local)",
            "Read(./.env.production)",
            "Read(./.env.staging)",
            "Read(./.env.backup)",
            "Bash(cat .env)",
            "Bash(cat .env.local)",
            "Bash(cat .env.production)",
            "Bash(cat .env.staging)",
            "Bash(cat .env.backup)",
            "Bash(grep * .env)",
            "Bash(grep * .env.local)",
            "Bash(grep * .env.production)",
            "Bash(grep * .env.staging)",
            "Bash(grep * .env.backup)",
            "Bash(tail .env)",
            "Bash(tail .env.local)",
            "Bash(tail .env.production)",
            "Bash(tail .env.staging)",
            "Bash(tail .env.backup)",
            "Read(./storage/*.key)",
            "Read(./auth.json)",
            "Bash(cat *auth.json*)",
            "Bash(cat *storage/*.key*)",
            "Bash(grep * *auth.json*)",
            "Bash(grep * *storage/*.key*)",
            "Bash(tail *auth.json*)",
            "Bash(tail *storage/*.key*)"
        ],
        "allow": [
            "mcp__laravel-boost__database-schema",
            "mcp__laravel-boost__application-info",
            "mcp__laravel-boost__browser-logs",
            "mcp__laravel-boost__search-docs",
            "Bash(vendor/bin/pest*)",
            "Bash(php artisan test*)",
            "Bash(composer test*)",
            "Bash(composer coverage*)",
            "Bash(git add *)",
            "Bash(git commit -m ' *)",
            "Bash(composer show *)",
            "Bash(composer why *)",
            "Bash(php -v)",
            "Bash(composer dry-pint)",
            "Bash(composer dry-rector)",
            "Bash(tail -n *)",
            "Bash(cat <<*)",
            "Bash(cat app/*)",
            "Bash(cat tests/*)",
            "Bash(cat config/*)",
            "Bash(cat database/*)",
            "Bash(cat resources/*)",
            "Bash(cat routes/*)",
            "Bash(cat docs/*)",
            "Bash(cat lang/*)",
            "Bash(cat .ai/*)",
            "Bash(cat .claude/*)",
            "Bash(cat storage/logs/*)",
            "Bash(cat /tmp/*)",
            "Bash(cat composer.json)",
            "Bash(cat composer.lock)",
            "Bash(cat package.json)",
            "Bash(cat phpunit.xml)",
            "Bash(grep -n *)",
            "Bash(grep -rn * app/*)",
            "Bash(grep -rn * tests/*)",
            "Bash(grep -rn * config/*)",
            "Bash(grep -rn * database/*)",
            "Bash(grep -rn * resources/*)",
            "Bash(grep -rn * routes/*)",
            "Bash(grep -rn * docs/*)",
            "Bash(grep -rn * lang/*)",
            "Bash(grep -rn * .ai/*)",
            "Bash(grep -rn * .claude/*)",
            "Bash(vendor/bin/pint*)",
            "Bash(vendor/bin/phpstan analyse*)",
            "Bash(php artisan route:list*)",
            "Bash(composer qa *)",
            "Bash(composer rector:agentic*)",
            "Bash(composer pint:agentic*)",
            "Bash(composer stan:agentic*)",
            "Bash(gh issue view*)",
            "Bash(gh issue list*)",
            "Bash(./vendor/bin/phpstan analyse *)",
            "Bash(composer stan *)",
            "mcp__codegraph__*",
            "Bash(cat .env.testing)",
            "Bash(grep * .env.testing)",
            "Bash(grep * *.env.testing)",
            "Bash(tail .env.testing)",
            "Bash(tail *.env.testing)",
            "Read(./.env.testing)",
            "Edit(./.env.testing)"
        ]
    },
    "enableAllProjectMcpServers": true,
    "enabledMcpjsonServers": [
        "laravel-boost",
        "context7",
        "codegraph"
    ],
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-env-files.sh\""
                    },
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive-db.sh\""
                    },
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.sh\""
                    },
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-test-pipe.sh\""
                    }
                ]
            },
            {
                "matcher": "Read|Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-env-files.sh\""
                    }
                ]
            },
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-generated-files.sh\""
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-php.sh\""
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "codegraph prompt-hook"
                    }
                ]
            }
        ]
    }
}
